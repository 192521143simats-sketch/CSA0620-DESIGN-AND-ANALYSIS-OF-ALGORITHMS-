print("-" * 40)

n = int(input("enter a number: "))

# Iterative
fact = 1
for i in range(1, n + 1):
    fact *= i

print("Iterative Factorial :", fact)

# Recursive
def factorial(n):
    if n == 0 or n == 1:
        return 1
    return n * factorial(n - 1)

print("Recursive Factorial :", factorial(n))
