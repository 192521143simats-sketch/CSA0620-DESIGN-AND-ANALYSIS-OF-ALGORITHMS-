n = int(input("enter a number: "))

# Iterative
fib = []
a, b = 0, 1

for i in range(n):
    fib.append(a)
    a, b = b, a + b

print("Iterative Fibonacci :", fib)

# Recursive
def fibonacci(n):
    if n <= 1:
        return n
    return fibonacci(n - 1) + fibonacci(n - 2)

fib_rec = []
for i in range(n):
    fib_rec.append(fibonacci(i))

print("Recursive Fibonacci :", fib_rec)
